# Copy to .env and fill in. Never commit .env.
# docker-compose loads it into the n8n container.
#
# Do NOT add N8N_ENCRYPTION_KEY here: n8n generates it on first start and keeps it in
# n8n-data/config. A mismatched key makes the container fail at start-up.
#
# The Telegram bot token and the Anthropic API key are NOT environment variables.
# Create them as credentials inside n8n (Telegram API, Anthropic API) and select them on the nodes.

# Your own Telegram chat id. The assistant ignores every other sender, and if this is
# empty it ignores everyone. Message @userinfobot on Telegram to find it.
TELEGRAM_CHAT_ID=

# Public https address Telegram calls (a tunnel or reverse proxy), with a trailing slash.
WEBHOOK_URL=https://your-tunnel.example/

GENERIC_TIMEZONE=Africa/Nairobi
TZ=Africa/Nairobi
